# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_WHATSAPP_NUMBER=            # digits with country code, e.g. 27821234567

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=              # server only, never expose

# --- Payments (Paystack default) ---
PAYMENT_PROVIDER=paystack
PAYSTACK_SECRET_KEY=                    # server only
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# --- Payments (PayFast: not implemented yet, placeholders only) ---
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true   # PayFast adapter is a documented stub (lib/payments/payfast.ts)

# --- Future: Uber Direct delivery ---
UBER_DIRECT_CUSTOMER_ID=
UBER_DIRECT_CLIENT_ID=
UBER_DIRECT_CLIENT_SECRET=

# --- Security ---
ORDER_TOKEN_SECRET=                     # random 32+ char string for guest order links
